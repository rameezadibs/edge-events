# Cloudflare Turnstile Configuration
# Frontend Public Site Key (Safe to expose to client)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Backend Turnstile Secret Key (NEVER expose to client - server/serverless only)
TURNSTILE_SECRET_KEY=1x00000000000000000000000000000000AA

# Allowed Production Hostnames (Comma-separated)
ALLOWED_HOSTNAMES=theedgeevents.co,www.theedgeevents.co,the-edge-events.vercel.app,edgeevents.ae

# Private Operational / Notification Email (Kept secure on backend, never exposed in client JS)
CONTACT_NOTIFICATION_EMAIL=collin@theedgeevents.co
